# O projeto roda em Linux (VPS). Se os scripts forem versionados com CRLF, o
# servidor falha com "bad interpreter: /bin/bash^M".
* text=auto eol=lf

*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.example text eol=lf

# Bancos, perfis e imagens não devem ser convertidos.
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
