PORT=3000
HOST=0.0.0.0

# Local: http://localhost:3000
# Produção: use a URL HTTPS pública do seu domínio.
# Com HTTPS o servidor emite cookies com Secure automaticamente.
PUBLIC_BASE_URL=http://localhost:3000

# Atrás de um proxy/reverso (Nginx, Caddy, Cloudflare, VPS com Load Balancer)?
# Informe o número de proxies antes do servidor (ex.: 1 para um único proxy).
# Deixe vazio quando o Node recebe a conexão HTTP/HTTPS diretamente.
# Isso corrige o IP real e o cookie Secure atrás de HTTPS.
TRUST_PROXY=

# Sua InfiniteTag sem o símbolo $
INFINITEPAY_HANDLE=

# --- Comportamento do executor (opcional) ---
# Cadência de digitação por caractere, em milissegundos.
CADENCIA_MIN_MS=35
CADENCIA_MAX_MS=95

# Espera entre postagens da mesma conta, em segundos.
DELAY_ENTRE_POSTS_MIN=25
DELAY_ENTRE_POSTS_MAX=60