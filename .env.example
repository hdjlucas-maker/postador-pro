# ------------------------------------------------------------------
# Postador Pro — configuração de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ------------------------------------------------------------------

# --- Servidor ---
PORT=3000
HOST=0.0.0.0

# Local: http://localhost:3000
# Produção: a URL HTTPS pública do seu domínio. Com HTTPS o servidor emite
# cookies com Secure automaticamente, e o endereço precisa bater exatamente com
# o do navegador: é ele que valida a origem das requisições.
PUBLIC_BASE_URL=http://localhost:3000

# Atrás de um proxy reverso (Nginx, Caddy, Cloudflare Tunnel, Load Balancer)?
# Informe quantos proxies vêm antes do Node (ex.: 1 para um único proxy).
# Deixe vazio quando o Node recebe a conexão diretamente.
# Isso corrige o IP real (importante para o rate limit) e a detecção de HTTPS.
TRUST_PROXY=

# --- Cobrança (InfinitePay) ---
# Sua InfiniteTag, sem o símbolo $.
INFINITEPAY_HANDLE=
INFINITEPAY_API=https://api.checkout.infinitepay.io

# --- Administração ---
# E-mails que terão acesso ao painel administrativo (/admin).
# Separe por vírgula. Sem essa lista, ninguém é admin.
ADMIN_EMAILS=

# --- Extensão (autorização de origem) ---
# IDs das extensões autorizadas a chamar a API, separados por vírgula, SEM o
# prefixo chrome-extension://. Pegue em chrome://extensions, na página da
# extensão, em "ID". Vazio = nenhuma extensão pode chamar a API.
# A origem exata que o servidor aceita é chrome-extension://<ID>.
EXTENSAO_IDS=

# Validade do token que a extensão guarda no navegador. Ao expirar, o cliente
# entra com e-mail e senha outra vez.
TOKEN_EXTENSAO_DIAS=30

# --- Proteção contra tentativa de senha ---
# O rate limit por IP segura uma origem; estas duas opções seguram a conta.
# Após LOGIN_FALHAS_MAX senhas erradas em sequência, a conta trava por
# LOGIN_BLOQUEIO_MINUTOS, mesmo que as tentativas venham de IPs diferentes.
LOGIN_FALHAS_MAX=8
LOGIN_BLOQUEIO_MINUTOS=15

# --- E-mail (recuperação de senha e avisos de pagamento) ---
# Sem SMTP em produção o cliente não consegue recuperar a senha e o app nem
# sobe: a configuração é tratada como erro.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Postador Pro <nao-responda@seudominio.com>

# Somente desenvolvimento. Devolve o link de redefinição na resposta da API.
# Isso permitiria assumir a conta de qualquer e-mail cadastrado. Em produção
# a opção é ignorada mesmo que esteja marcada como 1.
EXPOSIR_LINK_REDEFINICAO=

# --- Dados ---
# Banco e backups. Guarde fora da pasta publicada pelo servidor web e faça
# backup desse diretório.
DATA_DIR=./data

# --- Avaliação e sessão ---
TRIAL_DAYS=7
SESSION_DAYS=30
RESET_TOKEN_MINUTES=60
LOGIN_MINUTOS=5

# --- Planos e limites ---
# Preços em centavos (2500 = R$ 25,00).
PLAN_MONTHLY_PRICE=2500
PLAN_ANNUAL_PRICE=24900

# Grupos por dia, campanhas ativas e destinos por campanha. Esses números são
# aplicados pela extensão, no navegador do cliente.
LIMIT_TRIAL_GRUPOS_DIA=10
LIMIT_TRIAL_CAMPANHAS=3
LIMIT_TRIAL_DESTINOS=5
LIMIT_PRO_GRUPOS_DIA=300
LIMIT_PRO_CAMPANHAS=50
LIMIT_PRO_DESTINOS=100

# --- Ritmo de publicação ---
# É o que evita bloqueio de conta: nunca publique em rajada. Os mesmos valores
# são lidos pela extensão.
# Digitação por caractere, em milissegundos.
CADENCIA_MIN_MS=35
CADENCIA_MAX_MS=95

# Espera entre postagens, em segundos.
DELAY_ENTRE_POSTS_MIN=25
DELAY_ENTRE_POSTS_MAX=60

# --- Limites de conteúdo ---
MAX_IMAGE_BYTES=8388608
MAX_TEXTOS=20
MAX_TEXT_LENGTH=5000
MAX_CAMPANHA_NOME=100
MIN_LEAD_MINUTES=2
MAX_DIAS_AGENDAMENTO=90

# --- Manutenção ---
# Intervalo de backup e compactação, em minutos (1 a 1440).
# O backup só roda com NODE_ENV=production e grava em <DATA_DIR>/backups.
BACKUP_MINUTOS=360
COMPACTACAO_MINUTOS=30
# Quantos backups manter. Com 6 horas de intervalo, 30 cópias dão ~7 dias.
BACKUPS_MAXIMOS=30

# --- Rate limit por IP ---
# Quantas vezes cada IP pode chamar a rota dentro da janela. Aumente apenas se
# houver vários usuários atrás do mesmo IP/proxy.
RATE_LIMIT_REGISTRO=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_TROCA_SENHA=10
RATE_LIMIT_RECUPERAR=5
RATE_LIMIT_REDEFINIR=10
RATE_LIMIT_EXCLUIR_CONTA=5
