# Dependências
node_modules/

# Estado local do Wrangler: banco D1 de desenvolvimento, cache e blobs.
# É o mesmo que o `.env`: máquina local, nunca versionado.
.wrangler/

# Segredos e configuração local
.env
.env.local
.env.*.local

# Dados do servidor: banco e backups.
# NADA aqui pode ser versionado — contém sessões, e-mails e senhas (hash).
data/
*.db
*.db~
*.db.lock
backups/

# Logs
logs/
*.log
npm-debug.log*

# Sistema operacional e editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
